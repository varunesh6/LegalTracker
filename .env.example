# ===================================================================
# LEGALTRACK - ENVIRONMENT CONFIGURATION TEMPLATE
# ===================================================================
# Copy this file to .env and configure values for your environment.
# Never commit the actual .env file or credentials to source control.

# Database Configuration (PostgreSQL / Spring Boot Data JPA)
DB_URL=jdbc:postgresql://localhost:5432/legaltrack
DB_USERNAME=postgres
DB_PASSWORD=postgres
# (Or for MySQL: DB_URL=jdbc:mysql://localhost:3306/legaltrack?createDatabaseIfNotExist=true&useSSL=false)

# JWT Security
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# File Storage
FILE_STORAGE_PATH=uploads

# Server Port
PORT=8080

# Court Integration
COURT_INTEGRATION_ENABLED=false
COURT_INTEGRATION_PROVIDER=mock

# Schedulers
CASE_SYNC_FIXED_RATE=3600000
HEARING_REMINDER_CRON=0 0 9 * * *
